{
  "name": "@feelsie/core",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "migrations"
  ],
  "type": "module",
  "imports": {
    "#core": "./src/index.ts",
    "#core/database": "./src/database.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./database": "./src/database.ts",
    "./d1": "./src/d1.ts",
    "./stack": "./src/Stack.ts",
    "./test-support": "./src/test-support/sqlite.ts",
    "./alchemy.run": "./alchemy.run.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack src/index.ts src/d1.ts src/Stack.ts --dts",
    "test": "vp test run --reporter=minimal"
  },
  "dependencies": {
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
